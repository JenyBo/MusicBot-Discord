DISCORD_TOKEN=your_bot_token_here
FFMPEG_EXECUTABLE=ffmpeg

# Optional: sync slash commands to one guild only (faster while developing)
# DEV_GUILD_ID=

# Optional: YouTube Data API for /trendingvn and /newmusicvn
# YOUTUBE_API_KEY=

# yt-dlp: Netscape cookies file (export from browser; path relative to project root or absolute)
# YTDLP_COOKIEFILE=cookies.txt

# Or base64-encoded cookie file content (e.g. for Render without uploading a file)
# YTDLP_COOKIE_B64=

# Comma-separated JS runtimes for YouTube challenge solving (needs yt-dlp[default] + Node or Deno on PATH)
# Default in code: deno,node. Example override: YTDLP_JS_RUNTIMES=node
# YTDLP_JS_RUNTIMES=
